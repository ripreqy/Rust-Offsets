inline uint32_t encrypt_fov(uint32_t plain) {
    plain += 0x07653076u;
    plain = (plain >> 30) | (plain << 2);
    plain -= 0x47991A80u;
    plain = (plain >> 4) | (plain << 28);
    return plain;
}
