inline uintptr_t client_entities(uintptr_t hv) {
    auto* p = reinterpret_cast<uint32_t*>(&hv);
    for (int i = 0; i < 2; ++i) {
        uint32_t v = p[i];
        v ^= 0x6B59DCD4u;
        v += 0x12F287EEu;
        v = (v << 10) | (v >> 22);
        v += 0x2AD5742Au;
        p[i] = v;
    }
    return hv;
}

