inline std::uintptr_t client_entities(std::uintptr_t hv_value)
{
    std::uintptr_t rax = hv_value;
    std::uint32_t* rdx = reinterpret_cast<std::uint32_t*>(&rax);
    for (std::uint32_t i = 0; i < 2; ++i)
    {
        std::uint32_t v = *rdx;
        v += 0x5B90BDF1u;
        v = (v << 13) | (v >> 19);
        v += 0x87F6F395u;
        v = (v << 10) | (v >> 22);
        *rdx = v;
        ++rdx;
    }
    return rax;
}

