    {
        std::uint32_t v = *rdx;
        v ^= 0x18EE70EFu;
        v = (v << 1) | (v >> 31);
        v ^= 0xDF94DFA3u;
        v += 0x2A6262F8u;
        *rdx = v;
        ++rdx;
    }
    return rax;
}


