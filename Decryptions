    for (int i = 0; i < 2; ++i, ++p) {
        uint32_t x = *p;
        x -= 0x5EA72894u;
        x ^= 0xC8B59642u;
        x = (x << 28) | (x >> 4);
        x += 0x560FCEE8u;
        *p = x;
    }
    return v;
}
 
