inline uint64_t decrypt_bn0(uint64_t v) {
    uint32_t* p = (uint32_t*)&v;
    for (int i = 0; i < 2; ++i, ++p) {
        uint32_t x = *p;
        x ^= 0x1D967507u;
        x = (x << 8) | (x >> 24);
        x -= 0x42DC34A6u;
        *p = x;
    }
    return v;
}
 
inline uint64_t decrypt_bn1(uint64_t v) {
    uint32_t* p = (uint32_t*)&v;
    for (int i = 0; i < 2; ++i, ++p) {
        uint32_t x = *p;
        x += 0x43A97588u;
        x = (x << 11) | (x >> 21);
        x ^= 0xEDBCB0B2u;
        *p = x;
    }
    return v;
}
 
