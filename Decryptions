inline uint64_t decrypt_bn0(uint64_t v) {
    uint32_t* p = (uint32_t*)&v;
    for (int i = 0; i < 2; ++i, ++p) {
        uint32_t x = *p;
        x = (x << 29) | (x >> 3);
        x ^= 0x52079D6Bu;
        x -= 0x067894B2u;
        *p = x;
    }
    return v;
}
 
inline uint64_t decrypt_bn1(uint64_t v) {
    uint32_t* p = (uint32_t*)&v;
    for (int i = 0; i < 2; ++i, ++p) {
        uint32_t x = *p;
        x = (x << 8) | (x >> 24);
        x ^= 0x86EB57BFu;
        x = (x << 21) | (x >> 11);
        *p = x;
    }
    return v;
}
 
